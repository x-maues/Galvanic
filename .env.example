# Galvanic — copy to .env and fill in. Everything here targets public testnets.

# --- Hedera testnet (the protected RWA leg) ---------------------------------
# Create an ECDSA account at https://portal.hedera.com/ and fund it from the faucet.
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=0x...
HEDERA_NETWORK=testnet
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Written by `npm run issue-asset` in contracts-hedera/ (also in issued-asset.json).
# The note holder is deliberately the SAME address as DEMO_ACCOUNT below: that shared
# identity is what lets a Hedera asset back a Sepolia position with no bridge.
HEDERA_BOND_ADDRESS=0x...
HEDERA_NOTE_HOLDER=0x...
HEDERA_NOTE_UNIT_PRICE_USD=10

# --- Ethereum Sepolia (the liquid crypto leg) --------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_DEPLOYER_KEY=...
# The account the product manages. Must equal HEDERA_NOTE_HOLDER.
DEMO_ACCOUNT=0x...

# Printed by `npm run deploy:sepolia` in contracts-sepolia/.
SEPOLIA_MOCK_COLLATERAL=0x...
SEPOLIA_MOCK_DEBT=0x...
SEPOLIA_REGISTRY=0x...
SEPOLIA_VAULT=0x...
SEPOLIA_EXECUTOR=0x...

# Who the executor accepts reports from. Left unset, deploy.ts uses the deployer so
# the enclave's report can be settled locally. Chainlink's Sepolia CRE Forwarder is
# 0xF8344CFd5c43616a4366C34E3EEE75af79a74482 — switch to it with
# `npm run use-don-forwarder` once Confidential Workflow deployment access is granted.
SEPOLIA_CRE_FORWARDER=

# --- The Graph ---------------------------------------------------------------
# Free key from https://thegraph.com/studio/apikeys/ (100k queries/month).
# There is no mock mode: without this, the risk service returns 503 and the policy
# has nothing to decide on. The live Messari Standardized Lending deployment IDs are
# registered in subgraph/exposure.ts.
GRAPH_API_KEY=

# --- Chainlink CRE -----------------------------------------------------------
# The workflow's own secrets — the private risk policy and the Graph credential used
# inside the enclave — live in cre-workflow/firewall-margin-workflow/.env, mapped by
# secrets.yaml. See that directory's .env.example.
