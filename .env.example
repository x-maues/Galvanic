# --- Hedera testnet (ATS / protected RWA leg) ---
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=302e...
HEDERA_NETWORK=testnet
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api

# --- Ethereum Sepolia (crypto margin leg + Chainlink challenge contracts) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/xxxx
SEPOLIA_DEPLOYER_KEY=0xabc...
SEPOLIA_CHALLENGE_CONTRACT=0x88574e7Cc0027afd04951daa09B64d4441931ba1
SEPOLIA_VIRTUAL_USD=0x6Fe92Ead5299040f50F095860b5A0A7A2D4041A2
SEPOLIA_VIRTUAL_ETH=0x5dED1a40c3D56dA42E7f932f781c0432556c9814

# --- The Graph (Subgraph Studio) ---
# Required for subgraph/server.ts to query LIVE Messari Lending subgraphs.
# Get one at https://thegraph.com/studio/apikeys/ (free tier: 100k queries/mo).
# Leave as "xxxx" (or unset) to run subgraph/server.ts in labeled mock mode.
GRAPH_API_KEY=xxxx
# Not used directly -- the real, currently-live Messari Lending v3.1.0 subgraph
# IDs (Aave v3, Compound v3, Spark Lend, ...) are registered in
# subgraph/exposure.ts (LENDING_SUBGRAPHS). Kept here only if you want to point
# at one additional/alternate deployment; see subgraph/README.md.
GRAPH_LENDING_SUBGRAPH_ID=xxxx

# --- Chainlink CRE ---
CRE_API_KEY=xxxx
CRE_ETH_PRIVATE_KEY=0xabc...
