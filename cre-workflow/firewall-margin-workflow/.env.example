###############################################################################
### CRE workflow secrets. Copy to `.env`. Never commit or share.            ###
###############################################################################

# Ethereum key the CRE CLI signs with for a deployed workflow. Any valid secp256k1
# key works for local `cre workflow simulate`.
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=staging-settings

# --- The private risk policy -------------------------------------------------
# These are the numbers the product exists to keep private. Publish them and an
# adversary knows exactly where this account gets liquidated, and for how much.
# They are released by the Vault DON only into the attested enclave.
POLICY_MIN_HEALTH_FACTOR=1.15
POLICY_LIQUIDATION_LTV_THRESHOLD=78
POLICY_MAX_CROSS_PROTOCOL_EXPOSURE_USD=250000
POLICY_MAX_LIQUIDATION_PCT=50
POLICY_MAX_MARKET_STRESS_BPS=250

# --- Graph gateway credential, used from inside the enclave ------------------
# Same key as GRAPH_API_KEY in the repo-root .env. It is loaded as a CRE secret so
# it never appears in workflow config, in a log line, or in the signed report.
CRE_GRAPH_API_KEY=
